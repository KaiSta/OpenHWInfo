# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go build artifacts
*.o
_.o
*.a

# Go build cache
*.cache

# Go workspace file
go.work

# NOTE: go.mod and go.sum are deliberately NOT ignored. This project is a Go
# module and both files must be committed for the build to be reproducible.

# Dependency directories (remove the comment below to include it)
vendor/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*.bak
*.tmp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files and debug output
*.log
debug.log
error.log

# Go tool output
vet_output.txt
go-build*
profile.tok
cover.out

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# Build directories
bin/
dist/
build/
out/

# Built application binary (make build writes it to the repo root). Build
# artifacts are not tracked: the binary churns on every build and is rebuilt by
# `make build` / `make package`.
/OpenHWInfo
/OpenHWInfo.so

# Documentation artifacts
docs/_build/
sphinx/_build/

# Web development
website/node_modules/
website/.next/
website/.cache/
website/dist/
